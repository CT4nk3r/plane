# ---------------------------------------------------------------------------
# ado-plane-sync — environment configuration
#
# This file documents every variable read by src/config.ts. Copy it to `.env`
# and fill in real values. With `docker compose up`, these are passed to the
# service container via `env_file: .env`.
# ---------------------------------------------------------------------------

# --- Azure DevOps (source) -------------------------------------------------
# Organization and project that owns the work items being synced.
ADO_ORG=your-azure-devops-org
ADO_PROJECT=your-azure-devops-project
# Personal Access Token with "Work Items (Read)" scope. Used to fetch the full
# work item and (optionally) post the backlink comment.
ADO_PAT=your-azure-devops-pat
# Shared secret used to authenticate inbound webhooks. Configure the same value
# on the ADO Service Hook (Basic auth password, or an `X-Webhook-Secret` header).
ADO_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Base URL + API version for the ADO REST API (defaults shown).
ADO_BASE_URL=https://dev.azure.com
ADO_API_VERSION=7.0
# When true, the service posts/updates a backlink comment on the ADO work item.
ADO_BACKLINK_ENABLED=false

# --- Plane (destination) ---------------------------------------------------
# Base URL of your Plane instance (no trailing /api/v1).
PLANE_BASE_URL=https://app.plane.so
# API key of a dedicated Plane bot/service user (mirrors WorkspaceIntegration.api_token).
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxx
# Target workspace slug and project UUID that work items are synced into.
PLANE_WORKSPACE_SLUG=your-workspace-slug
PLANE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# --- States / board columns (dynamic) --------------------------------------
# By default the service pulls your ADO board columns into Plane AS-IS and
# auto-creates any Plane state that doesn't exist yet. So you do NOT have to
# pre-create states in Plane.
#
# Optional rename map (ADO state name -> Plane state name). Leave as {} to keep
# ADO names. Example: {"To Do":"Todo"}.
STATE_MAP_JSON={}
# Auto-create missing Plane states from ADO states/columns.
AUTO_CREATE_STATES=true
# Optional group override per state name. The group decides the column category
# in Plane (backlog|unstarted|started|completed|cancelled). If omitted, the group
# is inferred from the name (e.g. Done->completed, To Do->unstarted, else the
# default below). Example: {"Test needed":"started","Integration":"started"}.
STATE_GROUP_MAP_JSON={}
# Group used when a state can't be inferred.
DEFAULT_STATE_GROUP=started

# --- What to pull in (all on by default for a full trial) ------------------
# Add the ADO work item type (Bug, User Story, Task, Test Case, ...) as a Plane label.
SYNC_WORK_ITEM_TYPE_AS_LABEL=true
# Optional prefix for that label, e.g. "type:" -> "type:Bug".
TYPE_LABEL_PREFIX=
# Pull ADO iterations/sprints into Plane Cycles (find-or-create + assign).
SYNC_ITERATIONS_AS_CYCLES=true
# Best-effort parent linking (when the parent work item is already synced).
SYNC_PARENT=true
# Map ADO priority (1..4) to Plane priority (urgent/high/medium/low).
SYNC_PRIORITY=true

# --- Provider / labels / users ---------------------------------------------
# Provider slug written to Plane `external_source` (and the `service` field).
SERVICE=azure_devops
EXTERNAL_SOURCE=azure_devops
# Label auto-created and applied to every synced issue (mirrors GithubRepositorySync.label).
DEFAULT_LABEL_NAME=Azure DevOps
# Native `data.users` user mapping: [{ "username": "...", "import": "map"|"invite"|false, "email": "..." }]
# `map` matches an existing Plane member by email; `false`/unmatched skips assignee.
# When empty, assignees are auto-matched by email.
USER_MAP_JSON=[]

# --- Service / database ----------------------------------------------------
PORT=3100
# Postgres connection string. If omitted, the service falls back to an in-memory
# store (handy for local demos/tests, but not durable).
DATABASE_URL=postgres://ado_plane:ado_plane@db:5432/ado_plane_sync
# Background worker: process queued webhook jobs in-process.
WORKER_ENABLED=true
WORKER_MAX_RETRIES=5
# Logging: error | warn | info | debug
LOG_LEVEL=info

# --- Backfill CLI (pnpm backfill <scope>) ----------------------------------
# Safety cap on how many existing work items a backfill run will process,
# and how many to sync in parallel (mind Plane's API rate limit).
BACKFILL_LIMIT=500
BACKFILL_CONCURRENCY=3
