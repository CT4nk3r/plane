{
  "name": "ado-plane-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Azure DevOps to Plane work item sync service (native to Plane's GitHub/Jira integration conventions)",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check:types": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "1.16.0",
    "cors": "^2.8.5",
    "express": "4.22.0",
    "helmet": "^7.1.0",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.23",
    "@types/node": "22.12.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "nock": "^14.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.8.3",
    "vitest": "^4.1.8"
  }
}
